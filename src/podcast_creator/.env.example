# Copy this file to .env and fill in your own values.
#   cp .env.example .env
# .env holds real credentials and must never be committed.

# ── Google Gemini ────────────────────────────────────────────────────────────
# Used for script generation, episode titles/descriptions and chapters.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Text-to-speech rotates across these keys to spread out rate limits. Set as many
# as you have (they may all be the same key); the rotation skips any left empty.
GEMINI_API_KEY_EV=your-gemini-api-key
GEMINI_API_KEY_WORK=
GEMINI_API_KEY_VAZAZON=
GEMINI_API_KEY_PERSONAL=
GEMINI_API_KEY_IAC=

# ── Podcast hosting (Transistor.fm) ──────────────────────────────────────────
# https://dashboard.transistor.fm/account
TRANSISTOR_API_KEY=your-transistor-api-key

# ── Languages ────────────────────────────────────────────────────────────────
# Comma-separated list processed when main.py is run with no argument.
# Every language listed here needs its own settings block below.
PODCAST_LANGUAGES=english

# ── Per-language podcast settings ────────────────────────────────────────────
# One block per language, prefixed with the language name in UPPERCASE.
# To add a language, copy a block, change the prefix, and add it to
# PODCAST_LANGUAGES above - no code changes needed.
#
#   TRANSISTOR_SHOW_ID          numeric show id from the Transistor API.
#                               Set to 0 to generate episodes without uploading.
#   TRANSISTOR_SHOW_IDENTIFIER  the show's slug/uuid, used to build dashboard links.
#   PODCAST_NAME                spoken aloud in the intro, so write it as it should
#                               be pronounced (Hebrew may use nikud).
#   MAN_SPEAKER_NAME            the male host's name, as spoken and as written in
#   WOMAN_SPEAKER_NAME          the script. These are also the TTS speaker labels.
#   TEXT_DIRECTION              right-to-left or left-to-right. Used for the HTML
#                               episode description. Defaults to left-to-right.

ENGLISH_TRANSISTOR_SHOW_ID=0
ENGLISH_TRANSISTOR_SHOW_IDENTIFIER=your-show-slug
ENGLISH_PODCAST_NAME=Tech Updates
ENGLISH_MAN_SPEAKER_NAME=Yuval
ENGLISH_WOMAN_SPEAKER_NAME=Amit
ENGLISH_TEXT_DIRECTION=left-to-right

# Example of a right-to-left language. Delete if you do not need it.
#HEBREW_TRANSISTOR_SHOW_ID=0
#HEBREW_TRANSISTOR_SHOW_IDENTIFIER=your-show-slug
#HEBREW_PODCAST_NAME=עִדְכּוּנֵי טֶכְנוֹלוֹגְיָה
#HEBREW_MAN_SPEAKER_NAME=יוּבָל
#HEBREW_WOMAN_SPEAKER_NAME=עָמִית
#HEBREW_TEXT_DIRECTION=right-to-left

# A language also needs its own tone template if you want to override the default
# wording: create tone_<language>.j2 next to prompt_for_podcast_generation.j2.
# Without one, tone_default.j2 is used.

# ── Paths ────────────────────────────────────────────────────────────────────
# Episodes are written to <OUTPUT_FOLDER_PREFIX>_<language>, e.g. /podcasts_english
OUTPUT_FOLDER_PREFIX=/absolute/path/to/podcast_output

# Input lists of source URLs, one per line. SINGLE produces one episode per URL;
# MULTI batches several URLs into one episode.
SINGLE_LINKS_FILEPATH=/absolute/path/to/single_links.txt
MULTI_LINKS_FILEPATH=/absolute/path/to/multi_links.txt

LOG_FILE_PATH=/absolute/path/to/podcast_creator.log
CACHE_FOLDER=/absolute/path/to/cache

# Watched by monitor_new_links.py; touching this file triggers a run.
GENERATE_PODCAST_TRIGGER_FILEPATH=/absolute/path/to/trigger.txt

# ── Script length ────────────────────────────────────────────────────────────
# Converts the requested episode length in minutes into a target word count.
# 140 suits a conversational pace; lower it for a slower delivery.
WORDS_PER_MINUTE=140

# ── Email notifications (optional, via MailerSend) ───────────────────────────
# Used to report URLs whose content could not be extracted, and new show drafts.
# Leave MAILERSEND_API_KEY or MAIL_SEND_TO empty to disable notifications - the
# pipeline logs a warning and carries on.
# https://app.mailersend.com/api-tokens
MAILERSEND_API_KEY=
MAIL_SEND_TO=you@example.com
# The From address must be on a domain you have verified with MailerSend.
MAIL_FROM_EMAIL=info@example.com
MAIL_FROM_NAME=Podcast Creator

# ── Paywalled sources (optional) ─────────────────────────────────────────────
# Credentials for logging in to TheMarker. Leave blank to skip those articles.
THEMARKER_USERNAME=
THEMARKER_PASSWORD=

# ── Misc ─────────────────────────────────────────────────────────────────────
# Set to 0 only if a source site presents a broken TLS certificate chain.
#PYTHONHTTPSVERIFY=1
